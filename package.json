{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "next build",
    "check": "tsc --noEmit",
    "db:setup": "tsx db/setup.ts",
    "dev": "tsx watch server.ts",
    "selfcheck": "tsx src/components/ui.selfcheck.ts && tsx src/server/mock.selfcheck.ts && tsx src/server/association.selfcheck.ts && tsx src/server/analytics.selfcheck.ts",
    "smoke": "tsx test/smoke.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "worker": "tsx worker/ingest.ts",
    "worker:watch": "tsx watch worker/ingest.ts"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/react": "^9.0.0",
    "next": "^15.0.0",
    "postgres": "^3.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^2.13.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
