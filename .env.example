# Copy to .env.local
DATABASE_URL=postgresql://argus:argus@localhost:5432/argus
REDIS_URL=redis://localhost:6379/0

# 1 = frontend reads /api/mock fixtures. Remove for live data.
NEXT_PUBLIC_MOCK=1
# 0 = stop the server's canned WebSocket loop once the real pipeline feeds it.
MOCK=1

# Ingest worker
ARGUS_PYTHON=.venv/bin/python
ARGUS_CAMERAS=CAM1=demo/cam1.mp4,CAM2=demo/cam2.mp4
