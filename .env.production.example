# Production settings for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   ./scripts/deploy-prepare.sh            # fills in the secrets for you
#
# .env.production is gitignored. This repository is PUBLIC — anything committed
# to it is visible to everyone and stays in the history even if deleted later.

# --------------------------------------------------------------- database --
POSTGRES_USER=argus
POSTGRES_DB=argus
# REQUIRED. Not "argus": this database holds registration numbers and camera
# locations, and the compose file refuses to start without a value here.
POSTGRES_PASSWORD=

# ------------------------------------------------------------------- TLS --
# WITH A DOMAIN pointed at this VPS — a real certificate, no browser warning:
#   ARGUS_SITE=argus.example.com
#   ARGUS_TLS=you@example.com
#
# IP ADDRESS ONLY — Let's Encrypt will not issue for a bare IP, so Caddy signs
# its own and every browser warns once:
#   ARGUS_SITE=:443
#   ARGUS_TLS=internal
#
# HTTPS is not optional either way: a phone will not hand over its camera to a
# plain-http page, and the pair flow simply does not work without it.
ARGUS_SITE=:443
ARGUS_TLS=internal

# ---------------------------------------------------- operator password --
# Argus authenticates nobody. Caddy holds the only password, and it covers the
# dashboard, the API, the event WebSocket and uploads.
#
# The pair links (/cam/<code>) are deliberately exempt, so a phone can join by
# link alone. That leaves the six-character code as the only thing guarding
# frame upload into a camera slot — it lets someone push video IN, never read
# plates or journeys back out.
ARGUS_USER=argus
# REQUIRED. Generate with:
#   docker run --rm caddy caddy hash-password --plaintext 'your password'
ARGUS_PASSWORD_HASH=

# ---------------------------------------------------------------- worker --
# Live camera sources, comma separated: CAM1=rtsp://…,CAM2=rtsp://…
# Leave EMPTY on a VPS with no video files. Uploads and paired phones are
# discovered from the database and need no entry here.
ARGUS_CAMERAS=

# Inference is CPU-bound and will use every core it is given. Leave the web
# tier something to answer requests with — roughly half the box.
WORKER_CPUS=2.0
